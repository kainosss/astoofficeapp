{
  // ASTO Office — Cloudflare Worker configuration.
  // The top-level configuration is for LOCAL DEVELOPMENT ONLY.
  // Production settings live under "env.production" and are used with `wrangler deploy --env production`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asto-office-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Never expose *.workers.dev or per-version preview URLs: they are not behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asto-office-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    // Development-only bypass. Refused at runtime whenever ENVIRONMENT is "production".
    "AUTH_MODE": "dev-bypass",
    "DEV_USER_EMAIL": "dev@localhost"
  },
  "env": {
    "production": {
      "name": "asto-office",
      "routes": [{ "pattern": "office.astosec.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "asto-office-prod",
          // Replace with the real id from `wrangler d1 create asto-office-prod --location=oc` (requires approval).
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "access",
        "DEV_USER_EMAIL": ""
        // ACCESS_TEAM_DOMAIN, ACCESS_AUD and ADMIN_EMAILS are set as encrypted secrets, not committed here:
        //   npx wrangler secret put ACCESS_TEAM_DOMAIN --env production   (e.g. https://<team>.cloudflareaccess.com)
        //   npx wrangler secret put ACCESS_AUD --env production           (Access application AUD tag)
        //   npx wrangler secret put ADMIN_EMAILS --env production         (comma-separated allowlist)
        // If any is missing, every API request fails closed with HTTP 500.
      }
    }
  }
}
